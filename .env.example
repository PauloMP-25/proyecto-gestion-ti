# ===================================================================
# CONFIGURACIÓN DE ENTORNO — HOSPITAL SANTA MARÍA DEL SOCORRO (HSMSI)
# Copia este archivo como .env y completa los valores correspondientes.
# ===================================================================

# Base de datos SQL Server 2022
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=db_servicedesk;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=admin123

# Seguridad JWT
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_256_bits_aqui
JWT_EXPIRATION=3600000

# Servidor de Correo Institucional (SMTP / Spring Mail)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu_correo_institucional@hsmsi.gob.pe
SPRING_MAIL_PASSWORD=tu_contrasena_de_aplicacion_o_smtp
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

# Servidor de Aplicación
SERVER_PORT=8080
LOG_LEVEL=INFO
